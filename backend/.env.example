# Optional. Without a key, the demo uses deterministic extraction and English excerpts.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PROVIDER_TIMEOUT_SECONDS=35

# Only needed when serving behind your own HTTPS frontend/reverse proxy.
# Add exact browser origins and hostnames, comma-separated; never include a URL path.
REPANATOMY_ALLOWED_ORIGINS=
REPANATOMY_ALLOWED_HOSTS=

# Optional fitness coach override for an OpenAI-compatible chat provider.
# If empty, fitness coaching uses GROQ_API_KEY / GROQ_BASE_URL / GROQ_MODEL.
FITNESS_COACH_API_KEY=
FITNESS_COACH_BASE_URL=
FITNESS_COACH_MODEL=
